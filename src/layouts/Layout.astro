---
import '../styles/global.css';
import { getArticles } from '../lib/microcms';
import { categoriesOf, joinCategoryNames } from '../lib/blog';

export interface Props {
	title: string;
	description?: string;
}

const categories = categoriesOf(await getArticles());
const { title, description = `${joinCategoryNames(categories)} の実装メモ` } = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2322343A'/%3E%3Cpath d='M9 9h14v4h-5v11h-4V13H9z' fill='%23E7C942'/%3E%3C/svg%3E" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
		<!-- 描画前にテーマを適用してチラつきを防ぐ -->
		<script is:inline>
			(() => {
				let t;
				try { t = localStorage.getItem('tb-theme'); } catch (_) {}
				document.documentElement.dataset.theme = t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			})();
		</script>
	</head>
	<body id="top">
		<a href="#main" class="sr-only">本文へ移動</a>
		<header class="site-header">
			<div class="wrap">
				<a href="/" class="logo" aria-label="TECH BLOG トップへ">
					<span class="logo-mark"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 1h14v4H10v10H6V5H1z" /></svg></span>
					<span>TECH BLOG</span>
				</a>
				<div class="header-tools">
					<form class="search" action="/" role="search">
						<label class="sr-only" for="q">記事を検索</label>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
						<input id="q" name="q" type="search" placeholder="記事を検索" autocomplete="off" />
						<kbd>/</kbd>
					</form>
					<button class="icon-btn" id="theme" type="button" aria-label="ダークモードに切り替え"></button>
				</div>
			</div>
			<div class="progress" id="progress"></div>
		</header>

		<main id="main" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div>
					<div class="big">TECH BLOG</div>
					<small>© {new Date().getFullYear()} TECH BLOG — {joinCategoryNames(categories, ' / ')} の実装メモ</small>
				</div>
				<a href="#top" class="to-top" id="footerTop">ページの先頭へ戻る</a>
			</div>
		</footer>
		<div class="toast" id="toast" role="status" aria-live="polite"></div>

		<script>
			const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

			/* テーマ切替 */
			const themeBtn = document.getElementById('theme')!;
			const moon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/></svg>';
			const sun = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>';
			function applyTheme(t: string, save = false) {
				document.documentElement.dataset.theme = t;
				themeBtn.innerHTML = t === 'dark' ? sun : moon;
				themeBtn.setAttribute('aria-label', t === 'dark' ? 'ライトモードに切り替え' : 'ダークモードに切り替え');
				if (save) try { localStorage.setItem('tb-theme', t); } catch (_) {}
			}
			applyTheme(document.documentElement.dataset.theme || 'light');
			themeBtn.addEventListener('click', () =>
				applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark', true)
			);

			/* 「/」で検索にフォーカス */
			const q = document.getElementById('q') as HTMLInputElement;
			document.addEventListener('keydown', (e) => {
				const tag = (document.activeElement?.tagName || '').toLowerCase();
				if (e.key === '/' && tag !== 'input' && tag !== 'textarea') {
					e.preventDefault();
					q.focus();
				}
			});

			/* ページ先頭へ */
			document.getElementById('footerTop')!.addEventListener('click', (e) => {
				e.preventDefault();
				window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
			});

			/* コードのコピー */
			document.addEventListener('click', (e) => {
				const cp = (e.target as Element).closest<HTMLButtonElement>('[data-copy]');
				if (!cp) return;
				const code = cp.closest('.code')?.querySelector('code')?.innerText ?? '';
				navigator.clipboard?.writeText(code).then(() => {
					cp.textContent = 'コピーしました';
					window.toast('コードをコピーしました');
					setTimeout(() => (cp.textContent = 'コピー'), 1800);
				});
			});

			/* トースト */
			let toastTimer: number | undefined;
			window.toast = (msg: string) => {
				const t = document.getElementById('toast')!;
				t.textContent = msg;
				t.classList.add('show');
				clearTimeout(toastTimer);
				toastTimer = window.setTimeout(() => t.classList.remove('show'), 2000);
			};
		</script>
	</body>
</html>
