---
import Layout from '../layouts/Layout.astro';
import Cover from '../components/Cover.astro';
import { getArticles } from '../lib/microcms';
import { catOf, categoriesOf, dotDate, excerptOf, readMin, two } from '../lib/blog';

const articles = await getArticles(); // 新しい順
const categories = categoriesOf(articles);
const noOf = (i: number) => articles.length - i; // 古い記事から 01, 02, …
const year = new Date().getFullYear();
---

<Layout title="TECH BLOG — Front-end Field Notes">
	<section class="hero pad">
		<div class="meta tag"><span>Front-end field notes</span><span>Vol.01 / {year}</span><span>{articles.length} notes</span><span>Tokyo, JP</span></div>
		<h1 aria-label="Front-end, field notes">
			<span class="ln"><span>Front<span class="slash">/</span></span></span>
			<span class="ln"><span><span class="ol">End</span> Field</span></span>
			<span class="ln"><span>Notes.</span></span>
		</h1>
		<div class="sticker" aria-hidden="true"><div><b>{articles.length}</b>notes<br />shipped</div></div>
		<div class="lede">
			<p>{categories.length}つのフレームワークと microCMS。<em>作って、つまずいて、直した</em>記録を、そのまま置いています。</p>
			<div class="stack">{categories.map((c) => <button type="button" data-filter={c.id}>{c.name}</button>)}</div>
		</div>
	</section>

	<section class="pad" id="feature">
		{articles.map((a, i) => (
			<a class="feature" href={`/articles/${a.id}`} data-id={a.id} data-cat={a.category?.name} hidden={i !== 0}>
				<Cover article={a} no={noOf(i)} eager={i === 0} />
				<div class="txt">
					<span class="tag"><span>Latest — No.{two(noOf(i))}</span><span>{dotDate(a.publishedAt)}</span></span>
					<span class="chip tag">{catOf(a.category?.name).name}</span>
					<h2>{a.title}</h2>
					<p>{excerptOf(a)}</p>
					<span class="go">Read the note <span aria-hidden="true">→</span></span>
				</div>
			</a>
		))}
	</section>

	<section class="archive pad" aria-labelledby="archTitle">
		<div class="archive-head"><h2 id="archTitle">Archive<sup id="count">{two(articles.length)}</sup></h2><span class="tag" id="scope">All frameworks</span></div>
		<div class="cols tag" aria-hidden="true"><span>No.</span><span>Title</span><span>Framework</span><span>Read</span><span></span></div>
		<ol id="list">
			{articles.map((a, i) => (
				<li class="entry" data-id={a.id} data-cat={a.category?.name} hidden={i === 0}>
					<a href={`/articles/${a.id}`}>
						<span class="no">{two(noOf(i))}</span>
						<h3>{a.title}</h3>
						<span class="fw tag">{catOf(a.category?.name).name}</span>
						<span class="min tag">{readMin(a.content)} min</span>
						<span class="arr" aria-hidden="true">→</span>
						<span class="more"><Cover article={a} no={noOf(i)} named={false} /><p>{excerptOf(a)}</p></span>
					</a>
				</li>
			))}
		</ol>
	</section>
</Layout>

<script>
	const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
	const $$ = <T extends Element = HTMLElement>(s: string) => [...document.querySelectorAll<T>(s)];
	const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const features = $$('.feature');
	const entries = $$('.entry');
	const names = Object.fromEntries($$('.filter[data-filter]').map((f) => [f.dataset.filter!, f.querySelector('b')!.textContent!]));
	const two = (n: number) => String(n).padStart(2, '0');

	const fromUrl = new URLSearchParams(location.search).get('cat') ?? '';
	let cat = names[fromUrl] && fromUrl !== 'All' ? fromUrl : 'All';

	function renderList() {
		const match = (el: HTMLElement) => cat === 'All' || el.dataset.cat === cat;
		const ids = entries.filter(match).map((el) => el.dataset.id); // 新しい順
		features.forEach((f) => (f.hidden = f.dataset.id !== ids[0]));
		entries.forEach((el) => (el.hidden = !match(el) || el.dataset.id === ids[0]));
		$('#count').textContent = two(ids.length);
		$('#scope').textContent = cat === 'All' ? 'All frameworks' : `Filtered: ${names[cat]}`;
		$$('.filter').forEach((b) => (b.dataset.filter === cat ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current')));
	}

	const vt = (fn: () => void) => {
		const d = document as Document & { startViewTransition?: (cb: () => void) => unknown };
		return !d.startViewTransition || reduced ? fn() : d.startViewTransition(fn);
	};

	document.addEventListener('click', (e) => {
		const f = (e.target as Element).closest<HTMLElement>('[data-filter]');
		if (!f) return;
		e.preventDefault();
		cat = f.dataset.filter!;
		history.replaceState(null, '', cat === 'All' ? '/' : `/?cat=${encodeURIComponent(cat)}`);
		vt(renderList);
		if (cat !== 'All') $('#feature').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
	});

	renderList();
	if (cat !== 'All') scrollTo({ top: $('#feature').offsetTop - 24 });
</script>
