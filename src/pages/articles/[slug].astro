---
import Layout from '../../layouts/Layout.astro';
import Cover from '../../components/Cover.astro';
import { getArticles } from '../../lib/microcms';
import type { Article } from '../../types/article';
import { catOf, dotDate, excerptOf, isoDate, processBody, readMin, two } from '../../lib/blog';

export const getStaticPaths = async () => {
	const articles = await getArticles(); // 新しい順
	const n = articles.length;
	return articles.map((article, i) => ({
		params: { slug: article.id },
		props: {
			article,
			no: n - i,
			total: n,
			prev: articles[i + 1] ? { article: articles[i + 1], no: n - i - 1 } : null,
			next: articles[i - 1] ? { article: articles[i - 1], no: n - i + 1 } : null,
		},
	}));
};

type Neighbor = { article: Article; no: number } | null;
interface Props {
	article: Article;
	no: number;
	total: number;
	prev: Neighbor;
	next: Neighbor;
}

const { article, no, total, prev, next } = Astro.props;
const c = catOf(article.category?.name);
const { html, headings, codeCount } = processBody(article.content);
---

<Layout title={`${article.title} | TECH BLOG`} description={excerptOf(article)} isArticle activeCat={c.id}>
	<article class="art pad">
		<div class="art-top tag">
			<a href="/">← Archive</a>
			<span>No.{two(no)} / {two(total)}</span>
			<a href={`/?cat=${encodeURIComponent(c.id)}`}>{c.name} →</a>
		</div>
		<header class="art-head">
			<span class="bigno" aria-hidden="true">{two(no)}</span>
			<div><span class="chip tag">{c.name}</span><h1>{article.title}</h1></div>
		</header>
		<Cover article={article} no={no} class="art-cover" eager />
		<div class="art-grid">
			<aside class="facts" aria-label="記事の情報と目次">
				<dl class="tag">
					<div><dt>Date</dt><dd><time datetime={isoDate(article.publishedAt)}>{dotDate(article.publishedAt).slice(5)}</time></dd></div>
					<div><dt>Read</dt><dd>{readMin(article.content)} min</dd></div>
					<div><dt>Parts</dt><dd>{two(headings.length)}</dd></div>
					<div><dt>Code</dt><dd>{two(codeCount)}</dd></div>
				</dl>
				{headings.length > 0 && (
					<ol>
						<li class="tag">Contents</li>
						{headings.map((h, n) => (
							<li><a href={`#${h.id}`} data-toc={h.id}><span>{two(n + 1)}</span>{h.text}</a></li>
						))}
					</ol>
				)}
				<div class="acts tag"><button type="button" data-share>Copy link</button><button type="button" data-top>Top ↑</button></div>
			</aside>
			<div>
				<div class="prose" set:html={html} />
				<nav class="nextprev" aria-label="前後の記事">
					{prev ? (
						<a href={`/articles/${prev.article.id}`}><span class="tag">← Prev / No.{two(prev.no)}</span><b>{prev.article.title}</b></a>
					) : <span></span>}
					{next && (
						<a href={`/articles/${next.article.id}`}><span class="tag">Next / No.{two(next.no)} →</span><b>{next.article.title}</b></a>
					)}
				</nav>
			</div>
		</div>
	</article>
</Layout>

<script>
	const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

	/* 目次：スムーズスクロール */
	document.addEventListener('click', (e) => {
		const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-toc]');
		if (!a) return;
		e.preventDefault();
		const id = a.dataset.toc!;
		document.getElementById(id)?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' });
		history.replaceState(null, '', `#${id}`);
	});

	/* 目次：読んでいる見出しをハイライト */
	const links = [...document.querySelectorAll<HTMLElement>('[data-toc]')];
	if (links.length) {
		const io = new IntersectionObserver(
			(es) => es.forEach((en) => en.isIntersecting && links.forEach((l) => l.classList.toggle('on', l.dataset.toc === en.target.id))),
			{ rootMargin: '-80px 0px -65% 0px' }
		);
		document.querySelectorAll('.prose h2').forEach((h) => io.observe(h));
	}
</script>
